# Alumni directory source.
#
# In the Google Sheet holding the form responses:
#   File -> Share -> Publish to web -> select the responses tab
#   -> "Comma-separated values (.csv)" -> Publish, then paste the URL here.
#
# Publishing exposes the sheet to anyone with the link, so keep any column you
# do not want public (email address, phone) OUT of that tab.
ALUMNI_SHEET_CSV_URL=

# Events calendar source. Same publishing steps as above, on the events
# responses sheet. Refreshes every 20 minutes.
EVENTS_SHEET_CSV_URL=
